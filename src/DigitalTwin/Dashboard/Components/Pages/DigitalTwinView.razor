@page "/"
@rendermode InteractiveServer
@inject EquipmentDataService DataService
@inject IJSRuntime JS
@implements IDisposable

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Style="height: 500px; position: relative;">
            <MudText Typo="Typo.h6" Class="mb-2">Factory Floor - 3D View</MudText>
            <canvas id="renderCanvas" style="width: 100%; height: 450px; display: block; touch-action: none;"></canvas>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Style="height: 500px; overflow-y: auto;">
            <MudText Typo="Typo.h6" Class="mb-2">Equipment Status</MudText>
            @if (!DataService.IsConnected)
            {
                <MudAlert Severity="Severity.Warning">Connecting to Surgewave broker...</MudAlert>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var equipment in DataService.EquipmentStates.Values.OrderBy(e => e.Id))
                    {
                        <MudListItem OnClick="@(() => SelectEquipment(equipment))"
                                     Class="@(selectedEquipment?.Id == equipment.Id ? "mud-primary-text" : "")">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@GetEquipmentIcon(equipment.Type)"
                                         Color="@GetStatusColor(equipment.Mode)"
                                         Class="mr-2" />
                                <div>
                                    <MudText Typo="Typo.body2">@equipment.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @equipment.Mode - Zone @equipment.Zone
                                    </MudText>
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">Selected Equipment Details</MudText>
            @if (selectedEquipment != null)
            {
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.subtitle2">@selectedEquipment.Name</MudText>
                        <MudChip T="string" Color="@GetStatusColor(selectedEquipment.Mode)" Size="Size.Small">
                            @selectedEquipment.Mode
                        </MudChip>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Zone: @selectedEquipment.Zone</MudText>
                        <MudText Typo="Typo.caption">Type: @selectedEquipment.Type</MudText>
                    </MudItem>
                </MudGrid>

                @if (selectedEquipment.LatestTelemetry != null)
                {
                    var t = selectedEquipment.LatestTelemetry;
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2">Telemetry</MudText>
                    <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                        <tbody>
                            <tr><td>Temperature</td><td>@t.Temperature.ToString("F1") C</td></tr>
                            <tr><td>Vibration</td><td>@t.Vibration.ToString("F2") mm/s</td></tr>
                            <tr><td>Pressure</td><td>@t.Pressure.ToString("F1") bar</td></tr>
                            <tr><td>Power</td><td>@t.Power.ToString("F1") kW</td></tr>
                            <tr><td>RPM</td><td>@t.Rpm.ToString("F0")</td></tr>
                            <tr><td>Flow Rate</td><td>@t.FlowRate.ToString("F1") m3/h</td></tr>
                        </tbody>
                    </MudSimpleTable>
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Select equipment to view details</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">Recent Anomalies</MudText>
            @if (DataService.RecentAnomalies.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No anomalies detected</MudText>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var anomaly in DataService.RecentAnomalies.TakeLast(10).Reverse())
                    {
                        <MudListItem>
                            <MudAlert Severity="@GetAnomalySeverity(anomaly.Severity)" Dense="true" Class="my-1">
                                <MudText Typo="Typo.body2">@anomaly.Description</MudText>
                                <MudText Typo="Typo.caption">@anomaly.EquipmentId - @anomaly.DetectedAt.ToString("HH:mm:ss")</MudText>
                            </MudAlert>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private EquipmentState? selectedEquipment;
    private bool isSceneInitialized;

    protected override void OnInitialized()
    {
        DataService.OnStateChanged += OnDataChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            await JS.InvokeVoidAsync("initBabylonScene");
            isSceneInitialized = true;
        }

        if (isSceneInitialized && DataService.EquipmentStates.Count > 0)
        {
            var equipmentData = DataService.EquipmentStates.Values.Select(e => new Dictionary<string, object>
            {
                ["id"] = e.Id,
                ["name"] = e.Name,
                ["type"] = e.Type.ToString(),
                ["zone"] = e.Zone,
                ["x"] = e.PositionX,
                ["y"] = e.PositionY,
                ["z"] = e.PositionZ,
                ["mode"] = e.Mode.ToString(),
                ["temperature"] = e.LatestTelemetry?.Temperature ?? 0,
                ["rpm"] = e.LatestTelemetry?.Rpm ?? 0
            }).ToArray();

            await JS.InvokeVoidAsync("updateEquipment", (object)equipmentData);
        }
    }

    private void OnDataChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SelectEquipment(EquipmentState equipment)
    {
        selectedEquipment = equipment;
        if (isSceneInitialized)
        {
            JS.InvokeVoidAsync("selectEquipment", equipment.Id);
        }
    }

    private static string GetEquipmentIcon(EquipmentType type) => type switch
    {
        EquipmentType.Pump => Icons.Material.Filled.Water,
        EquipmentType.Motor => Icons.Material.Filled.Settings,
        EquipmentType.Conveyor => Icons.Material.Filled.LocalShipping,
        EquipmentType.Compressor => Icons.Material.Filled.Air,
        _ => Icons.Material.Filled.DeviceHub
    };

    private static Color GetStatusColor(OperatingMode mode) => mode switch
    {
        OperatingMode.Running => Color.Success,
        OperatingMode.Stopped => Color.Default,
        OperatingMode.Maintenance => Color.Warning,
        OperatingMode.Fault => Color.Error,
        OperatingMode.Starting or OperatingMode.Stopping => Color.Info,
        _ => Color.Default
    };

    private static Severity GetAnomalySeverity(AnomalySeverity severity) => severity switch
    {
        AnomalySeverity.Critical => Severity.Error,
        AnomalySeverity.Warning => Severity.Warning,
        _ => Severity.Info
    };

    public void Dispose()
    {
        DataService.OnStateChanged -= OnDataChanged;
    }
}
