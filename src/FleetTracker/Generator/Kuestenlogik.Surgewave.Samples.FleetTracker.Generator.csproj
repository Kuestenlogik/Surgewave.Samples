<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress CA5394: Random is fine for simulation, not security-sensitive -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Kuestenlogik.Surgewave.Samples.FleetTracker.Shared.csproj" />
    <PackageReference Include="Kuestenlogik.Surgewave.Client" />
  </ItemGroup>

</Project>
