<Project>
  <!-- Central Package Version Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Needed so that the Microsoft.OpenApi pin applies to transitive dependencies. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Transitive pins: Microsoft.OpenApi 2.0.0 (from Surgewave 0.3.0) has GHSA-v5pm-xwqc-g5wc;
         2.9.0 is the patched 2.x line. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />

    <!-- Surgewave Core (from local or CI NuGet feed) -->
    <PackageVersion Include="Kuestenlogik.Surgewave.Plugins" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Client" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Core" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Runtime" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Streams" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Testing.Chaos" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Client.SchemaRegistry" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Client.SchemaRegistry.Json" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Api.Grpc.Client" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Connect" Version="0.3.1" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Compatibility.Confluent.Kafka" Version="0.3.1" />
    <!-- Surgewave Connectors (from local or CI NuGet feed) -->
    <PackageVersion Include="Kuestenlogik.Surgewave.Connector.Csv" Version="0.1.4" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Connector.Database" Version="0.1.4" />
    <!-- Surgewave AI (from local or CI NuGet feed) -->
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Agents" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Guardrails" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Prompts" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Evaluation" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Multimodal" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Documents" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Retrieval" Version="0.1.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.AI.Rag" Version="0.1.0" />
    <!-- Kafka -->
    <PackageVersion Include="Confluent.Kafka" Version="2.14.0" />
    <!-- gRPC -->
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0" />
    <!-- CLI / UI -->
    <PackageVersion Include="Spectre.Console" Version="0.54.0" />
    <PackageVersion Include="MudBlazor" Version="9.12.0" />

    <!-- Database -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- AI -->
    <PackageVersion Include="OpenAI" Version="2.8.0" />
    <PackageVersion Include="Qdrant.Client" Version="1.16.1" />
    <PackageVersion Include="OllamaSharp" Version="5.4.16" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <!-- Hosting -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <!-- Reactive -->
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11: advisory without a patched version (2.1.11 is the latest 2.x;
         3.x is a different major line). Suppressed until an upstream fix — tracked in Surgewave#54. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>
