<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Kuestenlogik/index.json" />
    <!-- Local feed for packages that are not published yet (Surgewave.AI.*):
         `dotnet pack` in the Surgewave.Ai repo into ../local-nuget. The folder must
         exist (repo layout: all Kuestenlogik repos as siblings). -->
    <add key="local-nuget" value="../local-nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <!-- Surgewave core + Connectors packages live on GitHub Packages
           (and, for stable releases, on nuget.org). -->
      <package pattern="Kuestenlogik.Surgewave.*" />
      <package pattern="surgewave-*" />
      <package pattern="surgewave" />
    </packageSource>
    <packageSource key="local-nuget">
      <!-- The longest pattern wins: AI.* comes from the local feed until the
           Surgewave.Ai repo releases. -->
      <package pattern="Kuestenlogik.Surgewave.AI.*" />
      <package pattern="Kuestenlogik.Surgewave.ML" />
    </packageSource>
  </packageSourceMapping>
</configuration>
