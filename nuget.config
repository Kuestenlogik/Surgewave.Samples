<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Kuestenlogik/index.json" />
    <!-- Lokaler Feed fuer noch nicht veroeffentlichte Pakete (Surgewave.AI.*):
         `dotnet pack` im Surgewave.Ai-Repo nach ../local-nuget. Ordner muss
         existieren (Repo-Layout: alle Kuestenlogik-Repos als Geschwister). -->
    <add key="local-nuget" value="../local-nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <!-- Surgewave core + Connectors packages live on GitHub Packages
           (and, for stable releases, on nuget.org). -->
      <package pattern="Kuestenlogik.Surgewave.*" />
      <package pattern="surgewave-*" />
      <package pattern="surgewave" />
    </packageSource>
    <packageSource key="local-nuget">
      <!-- Laengstes Pattern gewinnt: AI.* kommt vom lokalen Feed, bis das
           Surgewave.Ai-Repo released. -->
      <package pattern="Kuestenlogik.Surgewave.AI.*" />
      <package pattern="Kuestenlogik.Surgewave.ML" />
    </packageSource>
  </packageSourceMapping>
</configuration>
